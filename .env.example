# ─── Хранилище ───────────────────────────────────────────────────────────
# По умолчанию SQLite в ./var. Для нескольких пользователей используйте PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dpo
# DATA_DIR=./var
# MAX_UPLOAD_MB=30

# ─── ИИ-разбор (необязательно) ───────────────────────────────────────────
# Без ключа система работает на детерминированных правилах: классификация,
# сроки, флажки и драфты по шаблонам доступны в полном объёме.
# Ключ добавляет: уточнение спорных случаев, распознавание сложных сканов
# и адаптацию текста ответа под конкретное обращение.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5

# ─── OCR ─────────────────────────────────────────────────────────────────
# TESSERACT_LANG=rus+eng
# OCR_DPI=300

# ─── Пароли почтовых ящиков ──────────────────────────────────────────────
# Настройки IMAP задаются в интерфейсе (Справочники → Почтовые ящики),
# а сам пароль берётся из переменной окружения, имя которой там указано.
# Пример: в карточке ящика указано IMAP_PRIVACY_PASSWORD, тогда здесь:
# IMAP_PRIVACY_PASSWORD=...
